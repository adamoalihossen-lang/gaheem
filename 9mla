local savedPlayers = {}
local currentIndex = 1

local function updateSavedList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local totalHeight = 0
    
    for userId, data in pairs(savedPlayers) do
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Size = UDim2.new(1, -10, 0, 85)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(20, 35, 75)
        ItemFrame.Parent = ScrollingFrame
        
        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 6)
        ItemCorner.Parent = ItemFrame
        
        local AvatarImg = Instance.new("ImageLabel")
        AvatarImg.Size = UDim2.new(0, 65, 0, 65)
        AvatarImg.Position = UDim2.new(0.02, 0, 0.1, 0)
        AvatarImg.BackgroundTransparency = 1
        AvatarImg.Image = data.avatar or ""
        AvatarImg.Parent = ItemFrame
        
        local StatsLabel = Instance.new("TextLabel")
        StatsLabel.Size = UDim2.new(0.60, 0, 0.9, 0)
        StatsLabel.Position = UDim2.new(0.26, 0, 0.05, 0)
        StatsLabel.BackgroundTransparency = 1
        StatsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        StatsLabel.TextSize = 12
        StatsLabel.Font = Enum.Font.SourceSansBold
        StatsLabel.TextXAlignment = Enum.TextXAlignment.Right
        StatsLabel.TextYAlignment = Enum.TextYAlignment.Center
        StatsLabel.TextWrapped = true
        
        local durationSecs = os.time() - data.regTime
        local hours = math.floor(durationSecs / 3600)
        local mins = math.floor((durationSecs % 3600) / 60)
        local secs = durationSecs % 60
        local timeFormatted = string.format("%02d:%02d:%02d", hours, mins, secs)
        
        StatsLabel.Text = "الاسم: " .. data.displayName .. " (@" .. data.name .. ")\n" ..
                          "وقت التسجيل: " .. timeFormatted .. "\n" ..
                          "مرات الخروج: " .. (data.leaves or 0) .. " | مرات الدخول: " .. (data.joins or 0)
        StatsLabel.Parent = ItemFrame
        
        local DeleteBtn = Instance.new("TextButton")
        DeleteBtn.Size = UDim2.new(0, 35, 0, 35)
        DeleteBtn.Position = UDim2.new(0.88, 0, 0.3, 0)
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        DeleteBtn.Text = "X"
        DeleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DeleteBtn.TextSize = 16
        DeleteBtn.Font = Enum.Font.SourceSansBold
        DeleteBtn.Parent = ItemFrame
        
        local DelCorner = Instance.new("UICorner")
        DelCorner.CornerRadius = UDim.new(0, 6)
        DelCorner.Parent = DeleteBtn
        
        DeleteBtn.MouseButton1Click:Connect(function()
            savedPlayers[userId] = nil
            updateSavedList()
        end)
        
        totalHeight = totalHeight + 90
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

AddBtn.MouseButton1Click:Connect(function()
    local allPlayers = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(allPlayers, p)
        end
    end
    
    if #allPlayers == 0 then return end
    
    if currentIndex > #allPlayers then
        currentIndex = 1
    end
    
    local foundPlayer = allPlayers[currentIndex]
    currentIndex = currentIndex + 1
    
    if foundPlayer then
        if not savedPlayers[foundPlayer.UserId] then
            savedPlayers[foundPlayer.UserId] = {
                name = foundPlayer.Name,
                displayName = foundPlayer.DisplayName,
                regTime = os.time(),
                leaves = 0,
                joins = 0,
                avatar = ""
            }
            
            task.spawn(function()
                local success, content = pcall(function()
                    return Players:GetUserThumbnailAsync(foundPlayer.UserId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
                end)
                if success and savedPlayers[foundPlayer.UserId] then
                    savedPlayers[foundPlayer.UserId].avatar = content
                    updateSavedList()
                end
            end)
        end
        TextBox.Text = foundPlayer.DisplayName
        updateSavedList()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if savedPlayers[player.UserId] then
        savedPlayers[player.UserId].leaves = (savedPlayers[player.UserId].leaves or 0) + 1
        updateSavedList()
    end
end)

Players.PlayerAdded:Connect(function(player)
    if savedPlayers[player.UserId] then
        savedPlayers[player.UserId].joins = (savedPlayers[player.UserId].joins or 0) + 1
        updateSavedList()
    end
end)

OpenButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    if MainFrame.Visible then
        updateSavedList()
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

task.spawn(function()
    while true do
        task.wait(1)
        if MainFrame.Visible then
            updateSavedList()
        end
    end
end)
